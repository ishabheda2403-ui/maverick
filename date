<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>A question for you</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,600&family=DM+Sans:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#2a1b3d; --card:#3a2653; --ink:#fdf2f8; --muted:#d8c4ea;
    --yes:#ff7eb6; --yes-ink:#2a1b3d; --no:#4b3568;
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{
    background:var(--bg); color:var(--ink);
    font-family:"DM Sans",system-ui,sans-serif;
    display:flex; align-items:center; justify-content:center; padding:24px;
    overflow:hidden;
  }
  main{
    width:min(520px,100%); background:var(--card); border-radius:28px;
    padding:40px 28px 36px; text-align:center; position:relative;
  }
  h1{
    font-family:"Fraunces",Georgia,serif; font-style:italic; font-weight:600;
    font-size:clamp(2rem,7vw,2.8rem); line-height:1.15; margin:0 0 12px;
  }
  p{color:var(--muted); line-height:1.5; margin:0 0 28px; font-size:1.05rem}
  .emoji{font-size:3.2rem; margin-bottom:14px; display:block}
  .row{display:flex; gap:14px; justify-content:center; flex-wrap:wrap; min-height:56px}
  button,.btn{
    font:inherit; font-weight:600; font-size:1.05rem; border:0; cursor:pointer;
    padding:14px 30px; border-radius:999px; text-decoration:none; display:inline-block;
    transition:transform .15s ease;
  }
  button:hover,.btn:hover{transform:scale(1.05)}
  button:focus-visible,.btn:focus-visible{outline:3px solid #fff; outline-offset:3px}
  #yes{background:var(--yes); color:var(--yes-ink)}
  #no{background:var(--no); color:var(--ink)}
  #no.run{position:fixed; z-index:5}
  [hidden]{display:none !important}
  .heart{position:fixed; top:-30px; pointer-events:none; animation:fall linear forwards}
  @keyframes fall{to{transform:translateY(110vh) rotate(40deg); opacity:.2}}
  @media (prefers-reduced-motion:reduce){.heart{display:none}}
</style>
</head>
<body>

<main>
  <!-- Step 1: the question -->
  <section id="ask">
    <span class="emoji" aria-hidden="true">🌷</span>
    <h1 id="title"></h1>
    <p id="sub"></p>
    <div class="row">
      <button id="yes">Yes</button>
      <button id="no">No</button>
    </div>
  </section>

  <!-- Step 2: the answer is yes -->
  <section id="done" hidden>
    <span class="emoji" aria-hidden="true">💖</span>
    <h1 id="doneTitle"></h1>
    <p id="doneSub"></p>
    <div class="row"><a class="btn" id="reply" style="background:var(--yes);color:var(--yes-ink)" target="_blank" rel="noopener">Send my reply</a></div>
  </section>
</main>

<script>
/* ============ EDIT THIS PART ============ */
const CONFIG = {
  friendName: "Ritik",             // his name
  yourName:   "Isha",              // your name
  title:      "Will you go on a date with me?",
  subtitle:   "Say yes and I'll take care of the rest.",
  doneTitle:  "Yay! It's a date.",
  doneNote:   "I'll message you the details soon. Get ready!",
  // Where his reply goes. Use ONE of these (leave the other as ""):
  whatsappNumber: "917507568877",  // your number: country code + number, no + or spaces
  email:          "",
  noButtonTexts: ["No", "Are you sure?", "Really?", "Think again", "Please?", "Last chance", "Okay, just say yes"]
};
/* ====================================== */

const $ = id => document.getElementById(id);
document.title = `For ${CONFIG.friendName}`;
$("title").textContent = `${CONFIG.friendName}, ${CONFIG.title.charAt(0).toLowerCase() + CONFIG.title.slice(1)}`;
$("sub").textContent = CONFIG.subtitle;

// The No button dodges the cursor / finger and changes its text
let noCount = 0;
const no = $("no");
function dodge(){
  noCount++;
  no.textContent = CONFIG.noButtonTexts[noCount % CONFIG.noButtonTexts.length];
  no.classList.add("run");
  const pad = 16;
  const x = Math.random() * (window.innerWidth  - no.offsetWidth  - pad*2) + pad;
  const y = Math.random() * (window.innerHeight - no.offsetHeight - pad*2) + pad;
  no.style.left = x + "px";
  no.style.top  = y + "px";
  // the Yes button grows a little each time
  $("yes").style.transform = `scale(${Math.min(1 + noCount * 0.08, 1.6)})`;
}
no.addEventListener("mouseenter", dodge);
no.addEventListener("touchstart", e => { e.preventDefault(); dodge(); }, {passive:false});
no.addEventListener("click", dodge);

// Yes
$("yes").addEventListener("click", () => {
  $("ask").hidden = true;
  $("done").hidden = false;
  $("doneTitle").textContent = CONFIG.doneTitle;
  $("doneSub").textContent = CONFIG.doneNote;

  const msg = `Yes! 💖 - ${CONFIG.friendName}`;
  const link = CONFIG.whatsappNumber
    ? `https://wa.me/${CONFIG.whatsappNumber}?text=${encodeURIComponent(msg)}`
    : `mailto:${CONFIG.email}?subject=${encodeURIComponent("My answer")}&body=${encodeURIComponent(msg)}`;
  $("reply").href = link;

  hearts();
});

function hearts(){
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  for (let i = 0; i < 40; i++){
    const h = document.createElement("div");
    h.className = "heart";
    h.textContent = ["💖","💗","🌷","✨"][i % 4];
    h.style.left = Math.random()*100 + "vw";
    h.style.fontSize = (16 + Math.random()*20) + "px";
    h.style.animationDuration = (3 + Math.random()*3) + "s";
    h.style.animationDelay = (Math.random()*1.5) + "s";
    document.body.appendChild(h);
    setTimeout(() => h.remove(), 8000);
  }
}
</script>
</body>
</html>
